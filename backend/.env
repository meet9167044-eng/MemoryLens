# ── Phase 1: App Settings ─────────────────────────────────
PROJECT_NAME="MemoryLens API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Phase 2: Database ──────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:Meet%4012@localhost:5432/memorylens_db

# ── Phase A: Dataset Storage ───────────────────────────────
DATASET_STORAGE_PATH=./data/dataset
MAX_UPLOAD_SIZE_MB=50

# ── Phase B: LLM Configuration ─────────────────────────────
LLM_PROVIDER=gemini
# Add your Gemini API key below (get one free at aistudio.google.com)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Phase C: Embeddings ────────────────────────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
